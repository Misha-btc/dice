/target
.DS_Store

# Vendored test WASM are BUILD ARTIFACTS — regenerated by scripts/build-wasms.sh
# before `cargo test`. Kept out of git (run build-wasms.sh on a fresh clone).
/src/tests/wasm/*.wasm

# Cargo.lock IS tracked (immutable contract → reproducible builds) — do not ignore it.

# Any stray compiled artifacts / local junk
*.wasm
*.log
*.swp
*.swo
.env
.env.*
.idea/
.vscode/
node_modules/
